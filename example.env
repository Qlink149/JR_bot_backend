OPENAI_API_KEY=
MONGO_URI=
GUPSHUP_APP_ID=80ef136a-44bc-4a88-b141-5d9e5eb52864
GUPSHUP_TOKEN=
GUPSHUP_APP_NAME=JaipurRugs
GUPSHUP_API_KEY=
GUPSHUP_SOURCE=15559297806
GUPSHUP_PARTNER_TOKEN=
GUPSHUP_PARTNER_EMAIL=
GUPSHUP_PARTNER_CLIENT_SECRET=
GUPSHUP_PARTNER_PASSWORD=
GUPSHUP_PARTNER_APP_TOKEN=
# Optional fallback if your existing setup already stores the app token here.
GUPSHUP_WEBHOOK_TAG=jaipur-rugs-backend
GUPSHUP_WEBHOOK_VERSION=3
GUPSHUP_WEBHOOK_MODES=MESSAGE,SENT,DELIVERED,READ,DELETED,FAILED,OTHERS,ENQUEUED
GUPSHUP_WEBHOOK_SHOW_ON_UI=true
# Gupshup must call the single Vultr backend (not a separate Vercel app).
WEBHOOK_URL=https://api.vultr3.qlink.in/gupshup/message/hc
GUPSHUP_PRODUCT_TEMPLATE_NAME=jr_test_dyn_2
GUPSHUP_PRODUCT_TEMPLATE_TYPE=TEXT
GUPSHUP_PRODUCT_TEMPLATE_LANGUAGE=en
GUPSHUP_PRODUCT_TEMPLATE_CATEGORY=MARKETING
GUPSHUP_TEMPLATE_SEARCH_URL=https://www.jaipurrugs.com/in/search
GUPSHUP_TEMPLATE_EXAMPLE_PRODUCT_URL=https://www.jaipurrugs.com/in/rugs/pae-4250-desert-rose-desert-rose-rug
GUPSHUP_USE_PRODUCT_TEMPLATE=false
DEFAULT_COUNTRY_CODE=91
CORS_ORIGINS=https://qlink-jr.vercel.app,https://jaipurrugs.claraai.tech,https://jaipurrugs-bot.vercel.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Enable only for local dev when no reverse proxy sets CORS headers.
APP_CORS_ENABLED=false
# Set true on Vultr/production where nginx already adds Access-Control-* headers.
BEHIND_PROXY_CORS=true
ENV_MODE="dev"
PINECONE_API=
PINECONE_NAMESPACE=
JR_API_USERNAME=your-jr-api-username
JR_API_PASSWORD=your-jr-api-password
JR_API_CLIENT_ID=your-jr-api-client-id
JR_API_CLIENT_SECRET=your-jr-api-client-secret
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=jr-chatbot
R2_ACCOUNT_ENDPOINT=https://b166538fe6434f1c027568fda8861597.r2.cloudflarestorage.com
R2_PUBLIC_BASE=https://pub-706af74a9f2443aa9e89918b8fd710b9.r2.dev
# Required for GET /api/cron/sync-products (Vultr host cron — see scripts/vultr-cron-sync-products.sh)
CRON_SECRET=your-secret-token-here
# Product search extraction: regex | hybrid | llm_primary (default: regex)
SEARCH_EXTRACTION_MODE=llm_primary
# Legacy bool — if true and MODE unset, behaves as hybrid
SEARCH_LLM_EXTRACTION_ENABLED=false
# WhatsApp product images: Cloudinary Fetch → JPEG (same as Kisna). Required for
# reliable image headers when Meta/Gupshup cannot fetch images.jaipurrugs.com.
CLOUDINARY_CLOUD_NAME=
# Pause between outbound WhatsApp messages (product carousel pacing).
WHATSAPP_OUTBOUND_GAP_SECONDS=0.45
